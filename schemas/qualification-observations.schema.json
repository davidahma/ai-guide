{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/davidahmann/applied-ai-field-guide/schemas/qualification-observations.schema.json",
  "title": "Observed deployment qualification run",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "segment", "effect_class", "execution_mode", "policy_digest", "environment_digest", "grader_digest", "frozen_at", "started_at", "completed_at", "development", "qualification", "results"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "segment": { "type": "string", "minLength": 2 },
    "effect_class": { "enum": ["none", "staged", "reversible", "irreversible"] },
    "execution_mode": { "enum": ["terminal_replay", "policy_in_loop_rerun"] },
    "policy_digest": { "$ref": "#/$defs/digest" },
    "environment_digest": { "$ref": "#/$defs/digest" },
    "grader_digest": { "$ref": "#/$defs/digest" },
    "frozen_at": { "type": "string", "format": "date-time" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "development": { "$ref": "#/$defs/partition" },
    "qualification": { "$ref": "#/$defs/partition" },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "accepted", "reviewed"],
        "properties": {
          "case_id": { "$ref": "#/$defs/id" },
          "accepted": { "type": "boolean" },
          "reviewed": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "partition": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "group_id"],
        "properties": {
          "case_id": { "$ref": "#/$defs/id" },
          "group_id": { "$ref": "#/$defs/id" }
        }
      }
    }
  }
}
